# Breakfast Burst Planner - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED: Supabase Configuration
# ===========================================
# Get these from your Supabase project dashboard (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# OPTIONAL: Google AI (Gemini) API Key
# ===========================================
# For AI-powered recipe generation using Google Gemini
# Get your API key from: https://aistudio.google.com/apikey
# Without this key, the app will use template-based recipe generation
VITE_GOOGLE_AI_API_KEY=your-google-ai-api-key

# Alternative name (either works)
# VITE_GEMINI_API_KEY=your-google-ai-api-key

# ===========================================
# OPTIONAL: Unsplash API Key
# ===========================================
# For searching high-quality food photography images
# Get your access key from: https://unsplash.com/developers
# Without this key, the app will use curated fallback images
VITE_UNSPLASH_ACCESS_KEY=your-unsplash-access-key
